{
  "policy_version": "1.0",
  "display_name": "Worker",
  "description": "Execution at senior-engineer latitude bounded by lead authority",
  "role": {
    "id": "worker",
    "class": "execution",
    "authority_source": "lead_dispatch",
    "playbook": "roles/worker-agent.md"
  },
  "authority": {
    "may_decide": [
      "implementation_details_within_accepted_scope"
    ],
    "must_route": {
      "scope_boundary_question": "lead",
      "master_plan_discrepancy": "lead",
      "strategy_class_finding": "lead",
      "load_bearing_irreversible_decision": "lead"
    },
    "forbidden": [
      "drive_process",
      "take_strategic_product_decision",
      "ignore_architecture_test_strategy_or_review_standard",
      "approve_own_work",
      "expand_scope_unilaterally",
      "override_reviewer_critical_finding"
    ]
  },
  "channels": {
    "direct": [
      {
        "role": "lead",
        "purpose": "dispatch_refinement_status_and_closeout"
      },
      {
        "role": "reviewer",
        "purpose": "security_or_compliance_evidence_dialogue"
      }
    ],
    "bounded_clarification": [
      {
        "role": "architect",
        "purpose": "implementation_intent_or_boundary_clarification"
      },
      {
        "role": "qa",
        "purpose": "testability_or_fixture_clarification"
      },
      {
        "role": "designer",
        "purpose": "ui_construct_or_component_intent_clarification"
      }
    ],
    "forbidden": [
      "direct_pm_channel",
      "direct_operator_channel",
      "direct_cto_channel",
      "direct_spm_channel"
    ],
    "rhythm_d_apex": "cto"
  },
  "artefacts": {
    "reads": [
      "docs/tasks/**",
      "docs/prd/**",
      "docs/glossary/**",
      "docs/test-strategies/**",
      "docs/design-reviews/**",
      "docs/adr/**",
      "docs/design-system/**",
      "docs/ux-reviews/**",
      "docs/code-reviews/**",
      "docs/handoffs/**",
      "DESIGN.md"
    ],
    "writes": [
      "docs/closeouts/**",
      ".wip-handoff-staging/**",
      "docs/memory/**"
    ],
    "owns": [
      "regular_closeout",
      "merge_closeout",
      "wip_handoff",
      "addendum",
      "go_live_handbook_draft"
    ]
  },
  "skills": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "id": "agent:remember",
        "authorization": "triggered",
        "triggers": [
          "durable_lesson_or_operator_remember_directive"
        ]
      },
      {
        "id": "agent:good-morning",
        "authorization": "triggered",
        "triggers": [
          "session_start"
        ]
      },
      {
        "id": "agent:coordination-wip-handoff",
        "authorization": "triggered",
        "triggers": [
          "stop_on_degraded_clause",
          "structural_blocker",
          "cross_model_review_cap_hit"
        ],
        "rhythm_rules": {
          "A": "held_unless_dispatch_authorizes_rhythm_independent",
          "B": "continuous_after_staging_audit",
          "C": "queue_with_cycle_batch_unless_pre_authorized",
          "D": "continuous_after_staging_audit"
        },
        "cannot_authorize": [
          "draft_implementation_commit",
          "scope_expansion",
          "critical_finding_override"
        ]
      },
      {
        "id": "agent:structural-refactor-verification",
        "authorization": "triggered",
        "triggers": [
          "pure_structural_refactor"
        ]
      },
      {
        "id": "agent:verification-patterns",
        "authorization": "triggered",
        "triggers": [
          "rare_verification_audit"
        ]
      },
      {
        "id": "agent:routed-comms",
        "authorization": "read-reference"
      },
      {
        "id": "agent:coordination-closeout-templates",
        "authorization": "read-reference"
      },
      {
        "id": "mythical:verification-completion",
        "authorization": "triggered",
        "triggers": [
          "before_completion_or_delivery_claim"
        ]
      },
      {
        "id": "mythical:plan-execution",
        "authorization": "triggered",
        "triggers": [
          "executing_a_plan_or_dispatch_brief"
        ]
      },
      {
        "id": "mythical:code-review-response",
        "authorization": "triggered",
        "triggers": [
          "review_findings_received"
        ]
      },
      {
        "id": "mythical:implementation-planning",
        "authorization": "triggered",
        "triggers": [
          "large_multistep_dispatch"
        ]
      },
      {
        "id": "mythical:worktree-management",
        "authorization": "triggered",
        "triggers": [
          "worktree_based_dispatch"
        ]
      },
      {
        "id": "mythical:branch-lifecycle",
        "authorization": "triggered",
        "triggers": [
          "branch_create_name_push_report",
          "pre_handoff_to_gate_chain"
        ]
      },
      {
        "id": "mythical:test-driven-development",
        "authorization": "triggered",
        "triggers": [
          "feature_or_bugfix_implementation"
        ]
      },
      {
        "id": "mythical:root-cause-analysis",
        "authorization": "triggered",
        "triggers": [
          "bug_test_failure_or_unexpected_behavior"
        ]
      }
    ]
  },
  "mcp_access": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "key": "agent-bus",
        "authorization": "always"
      }
    ]
  },
  "git": {
    "edit_scope": [
      "dispatch_declared_files",
      "docs/closeouts/**",
      ".wip-handoff-staging/**",
      "docs/memory/**"
    ],
    "commit_scope": [
      "dispatch_declared_files",
      "docs/closeouts/**",
      "docs/memory/**"
    ],
    "push_rules": {
      "A": "after_lead_greenlight_except_admin_routed_bounce",
      "B": "continuous_after_closeout",
      "C": "cycle_batch_except_admin_routed_bounce",
      "D": "continuous_on_lead_word_no_operator_wait"
    },
    "stage_explicit_paths_only": true,
    "forbidden": [
      "stage_all_or_dot",
      "force_push_without_explicit_authorization",
      "push_other_repository_without_explicit_authorization"
    ]
  },
  "stops_and_overrides": [
    {
      "condition": "reviewer_critical_finding",
      "action": "stop_and_route_via_lead",
      "override_authority": "operator",
      "rhythm_d_route": "cto"
    },
    {
      "condition": "irreversible_action_without_confirmation",
      "action": "stop_and_await_lead_confirmation",
      "override_authority": "lead-with-acknowledgment"
    },
    {
      "condition": "reserved_irreversible_external_action",
      "action": "stop_and_route_via_lead_never_self_fire",
      "override_authority": "operator",
      "rhythm_d_route": "cto"
    },
    {
      "condition": "ambiguous_target_contradicts_prompt_claim",
      "action": "stop_and_report",
      "override_authority": "lead-with-acknowledgment"
    },
    {
      "condition": "missing_task_brief_required_field",
      "action": "bounce_back_to_lead",
      "override_authority": "lead-with-acknowledgment"
    },
    {
      "condition": "domain_fit_insufficient_for_high_blast_radius_unit",
      "action": "decline_at_intake_and_reroute_to_domain_ramped_seat_via_lead",
      "override_authority": "lead-with-acknowledgment"
    },
    {
      "condition": "green_path_merge_to_main_authorized_by_cto",
      "action": "land_authorized_green_path_push_per_overlay_binding",
      "override_authority": "none"
    },
    {
      "condition": "yolo_deploy_dispatch_cites_apex_authorization",
      "action": "execute_sanctioned_deploy_per_overlay_binding_then_record_health",
      "override_authority": "none"
    }
  ],
  "generated_surfaces": [
    "roles/worker-agent.md",
    "roles/worker-agent.claude.md",
    "roles/worker-agent.codex.md"
  ],
  "review_harness": true
}
