{
  "policy_version": "1.0",
  "display_name": "Ops",
  "description": "Production health observation (read-only); provisionable, launch-gated pending read-only observability MCP allowlist/lease",
  "role": {
    "id": "ops",
    "class": "observation",
    "authority_source": "operator_or_scheduler_dispatch",
    "playbook": "roles/ops-agent.md"
  },
  "authority": {
    "may_decide": [
      "anomaly_detection_within_sweep_scope",
      "severity_grading_within_reviewer_taxonomy",
      "maintenance_task_intake_drafting",
      "production_bug_intake_drafting",
      "security_or_compliance_intake_drafting",
      "sweep_coverage_selection_within_contract"
    ],
    "must_route": {
      "production_incident": "operator",
      "routine_maintenance_task": "pm_or_lead",
      "production_bug_intake": "pm_or_lead",
      "deploy_or_infra_change_required": "lead",
      "security_or_compliance_class_finding": "pm_or_lead"
    },
    "forbidden": [
      "deploy_or_rollback",
      "mutate_infrastructure",
      "execute_or_modify_production_code",
      "modify_production_configuration",
      "prioritise_backlog",
      "dispatch_workers",
      "hold_release_authority",
      "duplicate_reviewer_security_compliance_verdict"
    ]
  },
  "channels": {
    "direct": [
      {
        "role": "operator",
        "purpose": "incident_surface_and_dispatch"
      },
      {
        "role": "pm",
        "purpose": "maintenance_and_bug_intake_delivery"
      },
      {
        "role": "lead",
        "purpose": "small_clear_maintenance_intake_delivery"
      }
    ],
    "bounded_clarification": [],
    "forbidden": [
      "worker_direct_dispatch",
      "direct_strategic_escalation_bypassing_apex"
    ],
    "rhythm_d_apex": "cto"
  },
  "artefacts": {
    "reads": [
      "**"
    ],
    "writes": [
      "docs/ops-intake/**",
      "docs/incidents/**"
    ],
    "owns": [
      "ops_intake_artefact",
      "incident_surface",
      "ops_docs_bar_gate_record"
    ]
  },
  "skills": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "id": "agent:docs-bar-gate",
        "authorization": "triggered",
        "triggers": [
          "recurring_docs_drift_check"
        ]
      },
      {
        "id": "agent:coordination-closeout-templates",
        "authorization": "read-reference"
      }
    ]
  },
  "mcp_access": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "key": "agent-bus",
        "authorization": "always"
      },
      {
        "key": "observability-readonly",
        "authorization": "leased"
      }
    ]
  },
  "git": {
    "edit_scope": [
      "docs/ops-intake/**",
      "docs/incidents/**"
    ],
    "commit_scope": [
      "docs/ops-intake/**",
      "docs/incidents/**"
    ],
    "push_rules": {
      "A": "self_push_each_commit_incident_and_intake",
      "B": "self_push_each_commit_incident_and_intake",
      "C": "self_push_each_commit_incident_and_intake",
      "D": "incident_self_push_intake_commit_stop_single_pusher"
    },
    "stage_explicit_paths_only": true,
    "forbidden": [
      "stage_all_or_dot",
      "write_outside_output_directory",
      "execute_or_modify_production",
      "mutate_infrastructure",
      "build_install_deploy_commands"
    ]
  },
  "stops_and_overrides": [
    {
      "condition": "production_incident_detected",
      "action": "surface_incident_to_operator_regardless_of_rhythm",
      "override_authority": "operator",
      "rhythm_d_route": "cto"
    },
    {
      "condition": "diagnosis_requires_a_mutating_action",
      "action": "stop_do_not_mutate_intake_a_worker_task_instead",
      "override_authority": "none"
    },
    {
      "condition": "high_severity_or_ambiguous_bug",
      "action": "route_to_pm_for_prioritisation_not_lead",
      "override_authority": "none"
    },
    {
      "condition": "missing_live_recipient_for_routed_artefact",
      "action": "surface_missing_session_do_not_mark_delivered",
      "override_authority": "none"
    },
    {
      "condition": "read_only_allowlist_not_enforceable",
      "action": "stop_before_touching_production_facing_tools",
      "override_authority": "none"
    },
    {
      "condition": "no_resolvable_sweep_scope",
      "action": "emit_needs_scope_bounce_then_retire",
      "override_authority": "none"
    }
  ],
  "generated_surfaces": [
    "roles/ops-agent.md",
    "roles/ops-agent.claude.md",
    "roles/ops-agent.codex.md"
  ],
  "review_harness": false
}
