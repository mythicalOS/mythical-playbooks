{
  "policy_version": "1.0",
  "display_name": "Explorer",
  "description": "One-off read-only codebase reconnaissance",
  "role": {
    "id": "explorer",
    "class": "reconnaissance",
    "authority_source": "operator_dispatch",
    "playbook": "roles/explorer-agent.md"
  },
  "authority": {
    "may_decide": [
      "search_breadth_selection",
      "result_filtering",
      "followup_question_scoping",
      "coverage_and_critical_path_selection_within_contract",
      "subexplorer_dispatch_gated_by_meta_checkpoint_approval"
    ],
    "must_route": {
      "runtime_evidence_needed": "worker_dispatch_recommendation",
      "architecture_class_load_bearing_hard_to_reverse_candidate": "operator",
      "subexplorer_cross_repo_or_escalation_candidate": "parent_explorer"
    },
    "forbidden": [
      "modify_target_codebase",
      "execute_target_code",
      "run_build_install_test_commands",
      "make_architecture_decisions",
      "prioritise_backlog",
      "drive_feature_development",
      "prescribe_architectural_change",
      "take_scope_decisions"
    ]
  },
  "channels": {
    "direct": [
      {
        "role": "operator",
        "purpose": "dispatch_checkpoint_approval_and_recon_delivery"
      },
      {
        "role": "explorer",
        "purpose": "subexplorer_to_parent_checkpoint_and_recon_delivery"
      }
    ],
    "bounded_clarification": [],
    "forbidden": [
      "lead_as_dispatcher_channel",
      "pm_as_dispatcher_channel"
    ]
  },
  "artefacts": {
    "reads": [
      "**"
    ],
    "writes": [
      "<designated-output-dir>/**"
    ],
    "owns": [
      "recon_artefact"
    ]
  },
  "skills": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "id": "agent:good-morning",
        "authorization": "triggered",
        "triggers": [
          "session_start"
        ]
      },
      {
        "id": "agent:coordination-closeout-templates",
        "authorization": "read-reference"
      }
    ]
  },
  "mcp_access": {
    "list_is_exhaustive": true,
    "allowed": [
      {
        "key": "agent-bus",
        "authorization": "always"
      }
    ]
  },
  "git": {
    "edit_scope": [
      "<designated-output-dir>/**"
    ],
    "commit_scope": [
      "<designated-output-dir>/**"
    ],
    "push_rules": {},
    "stage_explicit_paths_only": true,
    "forbidden": [
      "stage_all_or_dot",
      "write_outside_output_directory",
      "stage_or_commit_target_codebase",
      "execute_target_code",
      "run_build_install_test_commands"
    ]
  },
  "stops_and_overrides": [
    {
      "condition": "breadth_pass_complete_before_deep_pass",
      "action": "emit_coverage_plan_checkpoint_and_stop_for_approval",
      "override_authority": "operator",
      "rhythm_d_route": "operator"
    },
    {
      "condition": "multi_repo_fanout_before_subexplorer_spawn",
      "action": "emit_meta_checkpoint_and_stop_for_operator_human_approval",
      "override_authority": "operator",
      "rhythm_d_route": "operator"
    },
    {
      "condition": "runtime_evidence_required_to_answer_question",
      "action": "mark_unknown_and_recommend_separate_worker_dispatch",
      "override_authority": "none"
    },
    {
      "condition": "output_directory_not_named_and_no_dispatch_default",
      "action": "stop_and_ask_do_not_guess",
      "override_authority": "none"
    },
    {
      "condition": "remote_source_named_without_temp_workspace_path",
      "action": "stop_and_ask_before_cloning",
      "override_authority": "none"
    },
    {
      "condition": "source_acquisition_failure",
      "action": "surface_explicitly_and_stop_no_partial_source_set",
      "override_authority": "none"
    },
    {
      "condition": "codebase_too_large_or_diverse_for_output_contract",
      "action": "surface_at_checkpoint_and_propose_narrower_or_phased_scope",
      "override_authority": "none"
    }
  ],
  "doctrine_source": "doctrine/explorer.md",
  "generated_surfaces": [
    "roles/explorer-agent.md",
    "roles/explorer-agent.claude.md",
    "roles/explorer-agent.codex.md"
  ],
  "review_harness": false
}
